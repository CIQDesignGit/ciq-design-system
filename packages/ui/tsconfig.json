{
  "extends": "@ciq-dev/tsconfig/base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "dist",
    // Intl.Segmenter (ResponseStream fade mode) needs ES2022 lib typings
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
